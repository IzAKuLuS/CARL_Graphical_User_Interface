{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "rootDir": "../src",
    "outDir": "../.test-build"
  },
  "include": [
    "../src/lib/passenger/*.ts",
    "../src/lib/rosbridge.ts",
    "../src/lib/rosConfig.ts",
    "../src/components/dashboard/passenger/*.tsx",
    "../src/app/error.tsx"
  ]
}
